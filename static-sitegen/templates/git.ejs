<%
  const gitConfig = page.git || {};
  const pageForRender = Object.assign({}, page, {
    columnLayout: null
  });

  const introHtml = gitConfig.introHtml || gitConfig.intro || '';

  const resolvedRepos = Array.isArray(gitConfig.resolvedRepos) ? gitConfig.resolvedRepos : [];
  const defaultRepoEntry = gitConfig.defaultRepoUrl
    ? resolvedRepos.find(repo => repo.detailUrl === gitConfig.defaultRepoUrl)
    : resolvedRepos[0];

  const layoutContent = include('partials/git-layout.ejs', {
    resolvedRepos,
    defaultRepoUrl: gitConfig.defaultRepoUrl || (defaultRepoEntry ? defaultRepoEntry.detailUrl : ''),
    defaultRepoLabel: gitConfig.defaultRepoLabel || (defaultRepoEntry ? defaultRepoEntry.label : 'selected repository'),
    leftPaneTitle: gitConfig.leftPaneTitle || 'Repositories',
    leftPaneDescription: gitConfig.leftPaneDescription || 'Select a repo to stream its activity log.',
    rightPaneTitle: gitConfig.rightPaneTitle || 'Repository Activity',
    rightPaneDescription: gitConfig.rightPaneDescription || 'Live HTML from the selected repository renders here.',
    introHtml
  });
%>
<%- include('base.ejs', {
  site,
  page: pageForRender,
  content: layoutContent,
  isSection
}) %>
