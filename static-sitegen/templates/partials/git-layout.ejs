<%
  const {
    resolvedRepos,
    defaultRepoUrl,
    defaultRepoLabel,
    leftPaneTitle,
    leftPaneDescription,
    rightPaneTitle,
    rightPaneDescription,
    introHtml,
    repoIndexUrl
  } = locals;

  let repoEntries = Array.isArray(resolvedRepos)
    ? resolvedRepos.filter(repo => repo && repo.detailUrl)
    : [];

  repoEntries = repoEntries.map(function(repo) {
    const normalized = { ...(repo || {}) };
    normalized.label = normalized.label || normalized.name || normalized.id || normalized.detailUrl || '';
    normalized.stage = normalized.stage || '';
    normalized.stageLabel = normalized.stageLabel || (normalized.stage ? normalized.stage.toUpperCase() : '');
    normalized.owner = normalized.owner || '';
    normalized.description = normalized.description || '';
    normalized.repoPath = normalized.repoPath || normalized.relativePath || '';
    normalized.searchText = (normalized.searchText || [
      normalized.label,
      normalized.stage,
      normalized.owner,
      normalized.description,
      normalized.repoPath,
      normalized.detailUrl,
      normalized.httpUrl
    ].filter(Boolean).join(' ')).toLowerCase();
    return normalized;
  });

  const defaultLabelRaw = defaultRepoLabel || '';
  const defaultUrlRaw = defaultRepoUrl || '';

  let defaultEntry = null;
  if (repoEntries.length > 0) {
    if (defaultUrlRaw) {
      defaultEntry = repoEntries.find(repo => repo.detailUrl === defaultUrlRaw) || null;
    }
    if (!defaultEntry && defaultLabelRaw) {
      const defaultLabelLower = defaultLabelRaw.toLowerCase();
      defaultEntry = repoEntries.find(repo => (repo.label || '').toLowerCase() === defaultLabelLower) || null;
    }
  }

  if (!defaultEntry && defaultUrlRaw) {
    repoEntries.unshift({
      id: (defaultLabelRaw || defaultUrlRaw).toLowerCase(),
      label: defaultLabelRaw || defaultUrlRaw,
      stage: '',
      stageLabel: '',
      owner: '',
      description: '',
      repoPath: '',
      detailUrl: defaultUrlRaw,
      httpUrl: '',
      searchText: (defaultLabelRaw || defaultUrlRaw).toLowerCase()
    });
    defaultEntry = repoEntries[0];
  }

  const safeDefaultRepoUrl = (defaultEntry && defaultEntry.detailUrl) || defaultUrlRaw || (repoEntries[0] ? repoEntries[0].detailUrl : '');
  const safeDefaultRepoLabel = (defaultEntry && defaultEntry.label) || defaultLabelRaw || (repoEntries[0] ? repoEntries[0].label : 'selected repository');

  const safeLeftPaneTitle = leftPaneTitle || 'Repositories';
  const safeLeftPaneDescription = leftPaneDescription || 'Browse repositories hosted on Core.';
  const safeRightPaneTitle = rightPaneTitle || 'Repository Activity';
  const safeRightPaneDescription = rightPaneDescription || 'Commit logs and files render here.';
  const sidebarFootnote = repoIndexUrl || '';
  const hasRepos = repoEntries.length > 0;
  const emptyMessage = hasRepos
    ? 'No repositories match your search.'
    : 'No repositories were discovered during the build. Update the git manifest or page configuration.';
  const disableRefresh = !safeDefaultRepoUrl;
%>
<section class="git-page">
  <div class="git-shell">
    <% if (introHtml) { %>
      <div class="git-hero">
        <%- introHtml %>
      </div>
    <% } %>

    <div class="git-grid">
      <aside class="git-sidebar" aria-labelledby="git-sidebar-title">
        <header class="git-sidebar-header">
          <h3 class="git-sidebar-title" id="git-sidebar-title"><%= safeLeftPaneTitle %></h3>
          <p class="git-sidebar-subtitle"><%= safeLeftPaneDescription %></p>
        </header>

        <div class="git-sidebar-search">
          <label class="visually-hidden" for="git-search-input">Search repositories</label>
          <input
            id="git-search-input"
            class="git-search-input"
            type="search"
            placeholder="Search repositories..."
            autocomplete="off"
            spellcheck="false"
          >
        </div>

        <ul class="git-repo-list" id="git-repo-list" role="listbox" aria-label="Repository list">
          <% repoEntries.forEach(function(repo) { %>
            <li class="git-repo-list-item">
              <button
                type="button"
                class="git-repo-button"
                data-git-url="<%= repo.detailUrl %>"
                data-git-label="<%= repo.label %>"
                data-git-search="<%= repo.searchText %>"
                data-git-stage="<%= repo.stage %>"
                data-git-owner="<%= repo.owner %>"
                data-git-path="<%= repo.repoPath %>"
              >
                <span class="git-repo-button-title"><%= repo.label %></span>
                <div class="git-repo-button-meta">
                  <% if (repo.stageLabel) { %>
                    <span class="git-repo-pill"><%= repo.stageLabel %></span>
                  <% } %>
                  <% if (repo.owner) { %>
                    <span class="git-repo-owner">@<%= repo.owner %></span>
                  <% } %>
                </div>
                <% if (repo.description) { %>
                  <p class="git-repo-button-desc"><%= repo.description %></p>
                <% } %>
                <% if (repo.repoPath) { %>
                  <p class="git-repo-button-path"><%= repo.repoPath %></p>
                <% } else if (repo.detailUrl) { %>
                  <p class="git-repo-button-path"><%= repo.detailUrl.replace(/^https?:\/\/[^/]+/, '').replace(/^\/+/, '') %></p>
                <% } %>
              </button>
            </li>
          <% }); %>
        </ul>

        <p class="git-empty" id="git-empty"<%= hasRepos ? ' hidden' : '' %>><%= emptyMessage %></p>

        <% if (sidebarFootnote) { %>
          <p class="git-sidebar-footnote">
            View the full catalog at
            <a href="<%= sidebarFootnote %>" target="_blank" rel="noopener"><%= sidebarFootnote %></a>.
          </p>
        <% } %>
      </aside>

      <section class="git-content" aria-labelledby="git-content-title">
        <header class="git-content-header">
          <div class="git-content-meta">
            <h3 class="git-content-title" id="git-content-title"><%= safeRightPaneTitle %></h3>
            <p class="git-content-subtitle">
              <span id="git-active-repo-label"><%= safeDefaultRepoLabel %></span>
            </p>
          </div>
          <button
            type="button"
            class="git-refresh"
            id="git-refresh-default"
            data-git-default-url="<%= safeDefaultRepoUrl %>"
            data-git-default-name="<%= safeDefaultRepoLabel %>"
            <%= disableRefresh ? ' disabled' : '' %>
          >
            Refresh default
          </button>
        </header>

        <p class="git-content-description"><%= safeRightPaneDescription %></p>

        <div class="git-content-body">
          <% if (hasRepos) { %>
            <div class="git-loading" id="git-detail-indicator" role="status" aria-live="polite">
              Loading <%= safeDefaultRepoLabel %>…
            </div>
            <div
              class="git-frame-wrap"
              id="git-frame-wrap"
              data-default-height="calc(100vh + 16rem)"
            >
              <iframe
                id="git-repo-frame"
                class="git-frame"
                title="Repository activity viewer"
                data-default-url="<%= safeDefaultRepoUrl %>"
                data-default-name="<%= safeDefaultRepoLabel %>"
                data-default-height="clamp(24rem, 80vh, 64rem)"
                loading="lazy"
              ></iframe>
              <noscript>
                <p>Enable JavaScript to view repository activity.</p>
              </noscript>
            </div>
          <% } else { %>
            <div class="git-empty-state" id="git-empty-state">
              <p>No repositories were bundled into this build. Update <code>config/stagit/manifest.txt</code> or the Git page configuration to populate the catalog.</p>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  (function() {
    if (typeof window === 'undefined' || !window.document) {
      return;
    }

    var repoButtons = Array.prototype.slice.call(document.querySelectorAll('.git-repo-button'));
    var repoItems = repoButtons.map(function(button) {
      var detailUrl = button.getAttribute('data-git-url') || '';
      var label = button.getAttribute('data-git-label') || detailUrl;
      var searchText = button.getAttribute('data-git-search') || (label + ' ' + detailUrl);
      return {
        button: button,
        detailUrl: detailUrl,
        label: label,
        searchText: searchText.toLowerCase()
      };
    });

    var repoListEl = document.getElementById('git-repo-list');
    var emptyStateEl = document.getElementById('git-empty');
    var searchInput = document.getElementById('git-search-input');
    var frameWrap = document.getElementById('git-frame-wrap');
    var activeLabel = document.getElementById('git-active-repo-label');
    var detailFrame = document.getElementById('git-repo-frame');
    var detailIndicator = document.getElementById('git-detail-indicator');
    var refreshBtn = document.getElementById('git-refresh-default');
    var activeButton = null;
    var spinnerTimeoutId = null;
    var frameWrapMinHeight = null;
    var frameInitialHeight = null;
    var frameDefaultHeight = null;
    var frameObserver = null;
    var postMessageOriginAllowlist = null;

    function resolveComputedDimension(element, propertyNames) {
      if (!element || !window.getComputedStyle) {
        return '';
      }
      var styles = window.getComputedStyle(element);
      if (!styles) {
        return '';
      }
      for (var i = 0; i < propertyNames.length; i += 1) {
        var value = styles.getPropertyValue(propertyNames[i]);
        if (value && value !== 'auto' && value !== '0px') {
          return value.trim();
        }
      }
      return '';
    }

    if (frameWrap) {
      frameWrapMinHeight = resolveComputedDimension(frameWrap, ['min-height', 'height']);
      frameDefaultHeight = frameWrap.getAttribute('data-default-height') || frameWrapMinHeight || '';
    }
    if (detailFrame) {
      frameInitialHeight = resolveComputedDimension(detailFrame, ['height', 'min-height']);
      if (!frameDefaultHeight) {
        frameDefaultHeight = detailFrame.getAttribute('data-default-height') || frameInitialHeight || '';
      }
    }

    if (!frameDefaultHeight) {
      frameDefaultHeight = 'clamp(24rem, 80vh, 64rem)';
    }

    function applyFrameHeight(heightValue) {
      if (!heightValue) {
        return;
      }
      if (frameWrap) {
        frameWrap.style.height = heightValue;
        frameWrap.style.minHeight = heightValue;
      }
      if (detailFrame) {
        detailFrame.style.height = heightValue;
        detailFrame.style.minHeight = heightValue;
      }
    }

    function cleanupFrameObserver() {
      if (frameObserver) {
        try {
          frameObserver.disconnect();
        } catch (error) {
          // ignore cleanup issues
        }
      }
      frameObserver = null;
    }

    function setupFrameObserver() {
      if (!detailFrame || !('ResizeObserver' in window)) {
        cleanupFrameObserver();
        return;
      }
      try {
        var doc = detailFrame.contentDocument;
        if (!doc) {
          cleanupFrameObserver();
          return;
        }
        var target = doc.body || doc.documentElement;
        if (!target) {
          cleanupFrameObserver();
          return;
        }
        cleanupFrameObserver();
        frameObserver = new ResizeObserver(function() {
          syncFrameHeight();
        });
        frameObserver.observe(target);
      } catch (error) {
        cleanupFrameObserver();
      }
    }

    function normalizeMessageEvent(event) {
      if (!event) {
        return null;
      }
      var data = event.data;
      if (typeof data === 'string') {
        try {
          data = JSON.parse(data);
        } catch (error) {
          return null;
        }
      }
      if (!data || typeof data !== 'object') {
        return null;
      }
      return data;
    }

    function isAllowedMessageOrigin(origin) {
      if (!origin) {
        return false;
      }
      if (!postMessageOriginAllowlist) {
        postMessageOriginAllowlist = [];
        if (frameWrap) {
          var allowAttr = frameWrap.getAttribute('data-allow-origins');
          if (allowAttr) {
            allowAttr.split(',').forEach(function(entry) {
              var token = (entry || '').trim();
              if (token) {
                postMessageOriginAllowlist.push(token);
              }
            });
          }
        }
        if (detailFrame) {
          var defaultUrl = detailFrame.getAttribute('data-default-url');
          if (defaultUrl) {
            try {
              var parsed = new URL(defaultUrl);
              var originValue = parsed.origin;
              if (originValue) {
                postMessageOriginAllowlist.push(originValue);
              }
            } catch (error) {
              // ignore parse failures
            }
          }
        }
      }
      if (postMessageOriginAllowlist.length === 0) {
        return true;
      }
      return postMessageOriginAllowlist.indexOf(origin) !== -1;
    }

    function setActiveButton(button) {
      if (activeButton && activeButton !== button) {
        activeButton.classList.remove('git-link-active');
      }
      activeButton = button || null;
      if (activeButton) {
        activeButton.classList.add('git-link-active');
      }
    }

    function getParentListItem(button) {
      return button ? button.closest('.git-repo-list-item') : null;
    }

    function filterList(query) {
      var needle = (query || '').trim().toLowerCase();
      var matches = 0;
      repoItems.forEach(function(entry) {
        var li = getParentListItem(entry.button);
        if (!li) {
          return;
        }
        var isMatch = !needle || entry.searchText.indexOf(needle) !== -1;
        li.hidden = !isMatch;
        if (isMatch) {
          matches += 1;
        }
      });
      if (emptyStateEl && repoItems.length > 0) {
        emptyStateEl.hidden = matches > 0;
      }
    }

    function showIndicator() {
      if (!detailIndicator) {
        return;
      }
      detailIndicator.hidden = false;
      detailIndicator.removeAttribute('aria-hidden');
      detailIndicator.style.display = '';
      detailIndicator.classList.remove('is-hidden');
      prepareFrameForLoad();
      applyFrameHeight(frameDefaultHeight);
      if (spinnerTimeoutId) {
        window.clearTimeout(spinnerTimeoutId);
      }
      spinnerTimeoutId = window.setTimeout(function() {
        hideIndicator();
      }, 7000);
    }

    function hideIndicator() {
      if (!detailIndicator) {
        return;
      }
      detailIndicator.hidden = true;
      detailIndicator.setAttribute('aria-hidden', 'true');
      detailIndicator.style.display = 'none';
      detailIndicator.classList.add('is-hidden');
      if (spinnerTimeoutId) {
        window.clearTimeout(spinnerTimeoutId);
        spinnerTimeoutId = null;
      }
    }

    function prepareFrameForLoad() {
      if (!detailFrame) {
        return;
      }
      detailFrame.style.visibility = 'hidden';
      applyFrameHeight(frameDefaultHeight);
    }

    function revealFrame() {
      if (!detailFrame) {
        return;
      }
      detailFrame.style.visibility = 'visible';
    }

    function syncFrameHeight() {
      if (!detailFrame) {
        return;
      }
      var fallbackHeight = frameDefaultHeight || frameInitialHeight || frameWrapMinHeight || '';
      var measuredHeight = null;

      try {
        var doc = detailFrame.contentDocument;
        if (doc) {
          var docElement = doc.documentElement;
          var body = doc.body;
          var docElementHeight = docElement ? Math.max(docElement.scrollHeight || 0, docElement.offsetHeight || 0) : 0;
          var bodyHeight = body ? Math.max(body.scrollHeight || 0, body.offsetHeight || 0) : 0;
          measuredHeight = Math.max(docElementHeight, bodyHeight);
        }
      } catch (error) {
        measuredHeight = null;
      }

      if (!measuredHeight) {
        try {
          if (detailFrame && detailFrame.contentWindow) {
            detailFrame.contentWindow.postMessage({
              type: 'cmGit:height:request'
            }, '*');
          }
        } catch (error) {
          // unable to post message to child
        }
      }

      if (measuredHeight && measuredHeight > 0) {
        var paddingOffset = 24;
        applyFrameHeight((measuredHeight + paddingOffset) + 'px');
      } else if (fallbackHeight) {
        applyFrameHeight(fallbackHeight);
      } else {
        applyFrameHeight('calc(100vh + 16rem)');
      }
    }

    function activateEntry(entry, options) {
      if (!entry || !entry.detailUrl || !detailFrame) {
        return;
      }
      var label = entry.label || entry.detailUrl;
      if (activeLabel) {
        activeLabel.textContent = label;
      }
      showIndicator();
      var forceReload = options && options.forceReload;
      var url = entry.detailUrl;
      if (forceReload) {
        var separator = url.indexOf('?') === -1 ? '?' : '&';
        url = url + separator + 'ts=' + Date.now();
      }
      detailFrame.setAttribute('data-active-url', entry.detailUrl);
      detailFrame.src = url;
      setActiveButton(entry.button);
      try {
        var targetOrigin = '*';
        if (entry.detailUrl) {
          targetOrigin = new URL(entry.detailUrl, window.location.href).origin || '*';
        }
        window.postMessage({
          type: 'cmGit:parent:activate',
          detailUrl: entry.detailUrl,
          label: label
        }, targetOrigin);
      } catch (error) {
        // non-fatal messaging error
      }
    }

    function findEntryByUrl(url) {
      if (!url) return null;
      return repoItems.find(function(entry) {
        return entry.detailUrl === url;
      }) || null;
    }

    function findEntryByLabel(label) {
      if (!label) return null;
      var normalized = label.toLowerCase();
      return repoItems.find(function(entry) {
        return (entry.label || '').toLowerCase() === normalized;
      }) || null;
    }

    if (detailFrame) {
      detailFrame.addEventListener('load', function() {
        hideIndicator();
        revealFrame();
        setupFrameObserver();
        syncFrameHeight();
        if (window.requestAnimationFrame) {
          window.requestAnimationFrame(function() {
            syncFrameHeight();
          });
        }
        window.setTimeout(function() {
          syncFrameHeight();
        }, 650);
        window.setTimeout(function() {
          syncFrameHeight();
        }, 2000);
        try {
          if (detailFrame.contentWindow) {
            detailFrame.contentWindow.postMessage({
              type: 'cmGit:height:request'
            }, '*');
          }
        } catch (error) {
          // message request optional
        }
      });
      detailFrame.addEventListener('error', function() {
        hideIndicator();
        revealFrame();
        cleanupFrameObserver();
        applyFrameHeight(frameDefaultHeight);
      });
    }

    window.addEventListener('message', function(event) {
      var payload = normalizeMessageEvent(event);
      if (!payload || !payload.type) {
        return;
      }
      if (!isAllowedMessageOrigin(event.origin)) {
        return;
      }
      if (payload.type === 'cmGit:height:update') {
        var heightValue = payload.height;
        if (typeof heightValue === 'number' && heightValue > 0) {
          applyFrameHeight(heightValue + 'px');
        } else if (typeof heightValue === 'string' && heightValue.trim().length > 0) {
          applyFrameHeight(heightValue.trim());
        }
        return;
      }
      if (payload.type === 'cmGit:height:declare') {
        var declared = payload.value;
        if (typeof declared === 'number' && declared > 0) {
          applyFrameHeight(declared + 'px');
        }
      }
    });

    repoButtons.forEach(function(button) {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        var entry = repoItems.find(function(item) {
          return item.button === button;
        });
        activateEntry(entry, { forceReload: false });
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function(event) {
        filterList(event.target.value || '');
      });
    }

    if (refreshBtn && !refreshBtn.disabled) {
      refreshBtn.addEventListener('click', function(event) {
        event.preventDefault();
        var defaultUrl = refreshBtn.getAttribute('data-git-default-url') || '';
        var defaultName = refreshBtn.getAttribute('data-git-default-name') || '';
        var entry = findEntryByUrl(defaultUrl) || findEntryByLabel(defaultName) || repoItems[0] || null;
        if (entry) {
          activateEntry(entry, { forceReload: true });
        }
      });
    }

    if (repoItems.length > 0) {
      filterList('');
      var defaultUrl = detailFrame ? detailFrame.getAttribute('data-default-url') : '';
      var defaultName = detailFrame ? detailFrame.getAttribute('data-default-name') : '';
      var initialEntry = findEntryByUrl(defaultUrl) || findEntryByLabel(defaultName) || repoItems[0];
      activateEntry(initialEntry, { forceReload: false });
    } else {
      hideIndicator();
    }
  })();
</script>
