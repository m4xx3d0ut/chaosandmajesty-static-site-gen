<%
  const {
    resolvedRepos,
    defaultRepoUrl,
    defaultRepoLabel,
    leftPaneTitle,
    leftPaneDescription,
    rightPaneTitle,
    rightPaneDescription,
    introHtml
  } = locals;

  let repoEntries = Array.isArray(resolvedRepos)
    ? resolvedRepos.filter(repo => repo && repo.detailUrl)
    : [];

  repoEntries = repoEntries.map(function(repo) {
    const normalized = { ...(repo || {}) };
    normalized.label = normalized.label || normalized.name || normalized.id || normalized.detailUrl || '';
    normalized.stage = normalized.stage || '';
    normalized.stageLabel = normalized.stageLabel || (normalized.stage ? normalized.stage.toUpperCase() : '');
    normalized.owner = normalized.owner || '';
    normalized.description = normalized.description || '';
    normalized.repoPath = normalized.repoPath || normalized.relativePath || '';
    normalized.fragmentPath = normalized.fragmentPath || normalized.fragment || '';
    normalized.limitedFragmentPath = normalized.limitedFragmentPath || normalized.fragmentPath || normalized.fragment || '';
    normalized.fullLogFragmentPath = normalized.fullLogFragmentPath || normalized.fullLogFragment || '';
    normalized.commitsJsonPath = normalized.commitsJsonPath || normalized.commitsJson || '';
    normalized.filesFragmentPath = normalized.filesFragmentPath || normalized.filesFragment || '';
    normalized.refsFragmentPath = normalized.refsFragmentPath || normalized.refsFragment || '';
    normalized.readmeFragmentPath = normalized.readmeFragmentPath || normalized.readmeFragment || '';
    normalized.cloneCommand = normalized.cloneCommand || '';
    normalized.logInitialLimit = Number.isFinite(normalized.logInitialLimit) ? normalized.logInitialLimit : null;
    normalized.logTotalCommits = Number.isFinite(normalized.logTotalCommits) ? normalized.logTotalCommits : null;
    normalized.searchText = (normalized.searchText || [
      normalized.label,
      normalized.stage,
      normalized.owner,
      normalized.description,
      normalized.repoPath,
      normalized.detailUrl,
      normalized.httpUrl
    ].filter(Boolean).join(' ')).toLowerCase();
    return normalized;
  });

  const defaultLabelRaw = defaultRepoLabel || '';
  const defaultUrlRaw = defaultRepoUrl || '';

  let defaultEntry = null;
  if (repoEntries.length > 0) {
    if (defaultUrlRaw) {
      defaultEntry = repoEntries.find(repo => repo.detailUrl === defaultUrlRaw) || null;
    }
    if (!defaultEntry && defaultLabelRaw) {
      const defaultLabelLower = defaultLabelRaw.toLowerCase();
      defaultEntry = repoEntries.find(repo => (repo.label || '').toLowerCase() === defaultLabelLower) || null;
    }
  }

  if (!defaultEntry && defaultUrlRaw) {
    repoEntries.unshift({
      id: (defaultLabelRaw || defaultUrlRaw).toLowerCase(),
      label: defaultLabelRaw || defaultUrlRaw,
      stage: '',
      stageLabel: '',
      owner: '',
      description: '',
      repoPath: '',
      detailUrl: defaultUrlRaw,
      httpUrl: '',
      searchText: (defaultLabelRaw || defaultUrlRaw).toLowerCase()
    });
    defaultEntry = repoEntries[0];
  }

  const safeDefaultRepoUrl = (defaultEntry && defaultEntry.detailUrl) || defaultUrlRaw || (repoEntries[0] ? repoEntries[0].detailUrl : '');
  const safeDefaultRepoLabel = (defaultEntry && defaultEntry.label) || defaultLabelRaw || (repoEntries[0] ? repoEntries[0].label : 'selected repository');
  const safeDefaultRepoFragment = (defaultEntry && defaultEntry.fragmentPath) || '';
  const safeDefaultRepoLimitedLog = (defaultEntry && defaultEntry.limitedFragmentPath) || safeDefaultRepoFragment;
  const safeDefaultRepoFullLog = (defaultEntry && defaultEntry.fullLogFragmentPath) || '';
  const safeDefaultRepoCommits = (defaultEntry && defaultEntry.commitsJsonPath) || '';
  const safeDefaultRepoFiles = (defaultEntry && defaultEntry.filesFragmentPath) || '';
  const safeDefaultRepoRefs = (defaultEntry && defaultEntry.refsFragmentPath) || '';
  const safeDefaultRepoReadme = (defaultEntry && defaultEntry.readmeFragmentPath) || '';
  const safeDefaultRepoLogLimit = defaultEntry && Number.isFinite(defaultEntry.logInitialLimit) ? defaultEntry.logInitialLimit : '';

  const safeLeftPaneTitle = leftPaneTitle || 'Repositories';
  const safeLeftPaneDescription = leftPaneDescription || 'Browse repositories hosted on Core.';
  const safeRightPaneTitle = rightPaneTitle || 'Repository Activity';
  const safeRightPaneDescription = rightPaneDescription || 'Commit logs and files render here.';
  const hasRepos = repoEntries.length > 0;
  const emptyMessage = hasRepos
    ? 'No repositories match your search.'
    : 'No repositories were discovered during the build. Update the git manifest or page configuration.';

  if (defaultEntry) {
    repoEntries = [
      defaultEntry,
      ...repoEntries.filter(repo => repo !== defaultEntry)
    ];
  }
%>
<section class="git-page">
  <div
    class="git-orientation-overlay"
    id="git-orientation-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="git-orientation-title"
    aria-describedby="git-orientation-copy"
    aria-hidden="true"
  >
    <div class="git-orientation-card">
      <h2 class="git-orientation-title" id="git-orientation-title">Rotate to landscape</h2>
      <p class="git-orientation-message" id="git-orientation-copy">For the best Git activity view, rotate your device to landscape.</p>
    </div>
  </div>
  <div class="git-shell">
    <% if (introHtml) { %>
      <div class="git-hero">
        <%- introHtml %>
      </div>
    <% } %>

    <div class="git-grid">
      <aside class="git-sidebar" id="git-sidebar" aria-labelledby="git-sidebar-title">
        <header class="git-sidebar-header">
          <h3 class="git-sidebar-title" id="git-sidebar-title"><%= safeLeftPaneTitle %></h3>
          <p class="git-sidebar-subtitle"><%= safeLeftPaneDescription %></p>
        </header>

        <div class="git-sidebar-search">
          <label class="visually-hidden" for="git-search-input">Search repositories</label>
          <input
            id="git-search-input"
            class="git-search-input"
            type="search"
            placeholder="Search repositories..."
            autocomplete="off"
            spellcheck="false"
          >
        </div>

        <ul class="git-repo-list" id="git-repo-list" role="listbox" aria-label="Repository list">
          <% repoEntries.forEach(function(repo) { %>
            <li class="git-repo-list-item">
              <button
                type="button"
                class="git-repo-button"
                data-git-id="<%= repo.id %>"
                data-git-url="<%= repo.detailUrl %>"
                data-git-label="<%= repo.label %>"
                data-git-search="<%= repo.searchText %>"
                data-git-stage="<%= repo.stage %>"
                data-git-owner="<%= repo.owner %>"
                data-git-path="<%= repo.repoPath %>"
                data-git-fragment="<%= repo.fragmentPath || '' %>"
                data-git-commits="<%= repo.commitsJsonPath || '' %>"
                data-git-files="<%= repo.filesFragmentPath || '' %>"
                data-git-refs="<%= repo.refsFragmentPath || '' %>"
                data-git-readme="<%= repo.readmeFragmentPath || '' %>"
                data-git-full-log="<%= repo.fullLogFragmentPath || '' %>"
                data-git-limited-log="<%= repo.limitedFragmentPath || repo.fragmentPath || '' %>"
                data-git-log-limit="<%= Number.isFinite(repo.logInitialLimit) ? repo.logInitialLimit : '' %>"
                data-git-log-total="<%= Number.isFinite(repo.logTotalCommits) ? repo.logTotalCommits : '' %>"
              >
                <span class="git-repo-button-title"><%= repo.label %></span>
                <div class="git-repo-button-meta">
                  <% if (repo.stageLabel) { %>
                    <span class="git-repo-pill"><%= repo.stageLabel %></span>
                  <% } %>
                  <% if (repo.owner) { %>
                    <span class="git-repo-owner">@<%= repo.owner %></span>
                  <% } %>
                </div>
                <% if (repo.description) { %>
                  <p class="git-repo-button-desc"><%= repo.description %></p>
                <% } %>
                <% if (repo.repoPath) { %>
                  <p class="git-repo-button-path"><%= repo.repoPath %></p>
                <% } else if (repo.detailUrl) { %>
                  <p class="git-repo-button-path"><%= repo.detailUrl.replace(/^https?:\/\/[^/]+/, '').replace(/^\/+/, '') %></p>
                <% } %>
              </button>
            </li>
          <% }); %>
        </ul>

        <p class="git-empty" id="git-empty"<%= hasRepos ? ' hidden' : '' %>><%= emptyMessage %></p>

      </aside>

      <section class="git-content" aria-labelledby="git-content-title">
        <header class="git-content-header">
          <div class="git-content-meta">
            <h3 class="git-content-title" id="git-content-title"><%= safeRightPaneTitle %></h3>
            <p class="git-content-subtitle">
              <span id="git-active-repo-label"><%= safeDefaultRepoLabel %></span>
            </p>
          </div>
          <div class="git-content-actions">
            <button
              type="button"
              class="git-sidebar-toggle"
              id="git-sidebar-toggle"
              aria-expanded="true"
              aria-controls="git-sidebar"
            >
              Hide repos
            </button>
          </div>
        </header>

        <p class="git-content-description"><%= safeRightPaneDescription %></p>

        <div class="git-content-body">
          <% if (hasRepos) { %>
            <div class="git-loading" id="git-detail-indicator" role="status" aria-live="polite">
              Loading <%= safeDefaultRepoLabel %>…
            </div>
            <nav class="git-panel-tabs" id="git-panel-tabs" aria-label="Repository views">
              <button type="button" class="git-tab-button" data-git-tab="log" aria-pressed="false">Log</button>
              <button type="button" class="git-tab-button" data-git-tab="files" aria-pressed="false">Files</button>
              <button type="button" class="git-tab-button" data-git-tab="readme" aria-pressed="false">README</button>
              <button type="button" class="git-tab-button" data-git-tab="refs" aria-pressed="false">Refs</button>
            </nav>
            <div
              class="git-panel-container"
              id="git-panel-container"
              data-default-fragment="<%= safeDefaultRepoFragment %>"
              data-default-url="<%= safeDefaultRepoUrl %>"
              data-default-name="<%= safeDefaultRepoLabel %>"
              data-default-limited-log="<%= safeDefaultRepoLimitedLog %>"
              data-default-full-log="<%= safeDefaultRepoFullLog %>"
              data-default-log-limit="<%= safeDefaultRepoLogLimit %>"
              data-default-commits="<%= safeDefaultRepoCommits %>"
              data-default-files="<%= safeDefaultRepoFiles %>"
              data-default-refs="<%= safeDefaultRepoRefs %>"
              data-default-readme="<%= safeDefaultRepoReadme %>"
            >
              <div class="git-panel-slot" id="git-panel-slot">
                <p class="git-panel-placeholder">Select a repository to load activity.</p>
              </div>
            </div>
            <noscript>
              <p>
                Enable JavaScript to view repository activity inline. You can open the full log at
                <% if (safeDefaultRepoUrl) { %>
                  <a href="<%= safeDefaultRepoUrl %>" target="_blank" rel="noopener"><%= safeDefaultRepoUrl %></a>.
                <% } else { %>
                  the repository’s source.
                <% } %>
              </p>
            </noscript>
          <% } else { %>
            <div class="git-empty-state" id="git-empty-state">
              <p>No repositories were bundled into this build. Update <code>config/git/manifest.txt</code> or the Git page configuration to populate the catalog.</p>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</section>

<button type="button" class="blog-back-to-top git-back-to-top" aria-label="Back to top">
  ▲
</button>

<script>
  (function() {
    if (typeof window === 'undefined' || !window.document) {
      return;
    }

    var TAB_ORDER = ['log', 'readme', 'files', 'refs'];
    var TAB_LABELS = {
      log: 'Log',
      files: 'Files',
      readme: 'README',
      refs: 'Refs'
    };

    var repoButtons = Array.prototype.slice.call(document.querySelectorAll('.git-repo-button'));
    var repoItems = repoButtons.map(function(button) {
      var detailUrl = button.getAttribute('data-git-url') || '';
      var label = button.getAttribute('data-git-label') || detailUrl;
      var searchText = button.getAttribute('data-git-search') || (label + ' ' + detailUrl);
      var fullLogFragment = button.getAttribute('data-git-full-log') || '';
      var limitedLogFragment = button.getAttribute('data-git-limited-log') || (button.getAttribute('data-git-fragment') || '');
      var logLimitAttr = button.getAttribute('data-git-log-limit') || '';
      var logTotalAttr = button.getAttribute('data-git-log-total') || '';
      var parsedLogLimit = parseInt(logLimitAttr, 10);
      var parsedLogTotal = parseInt(logTotalAttr, 10);
      var logInitialLimit = Number.isFinite(parsedLogLimit) ? parsedLogLimit : null;
      var logTotalCommits = Number.isFinite(parsedLogTotal) ? parsedLogTotal : null;
      return {
        id: button.getAttribute('data-git-id') || '',
        button: button,
        detailUrl: detailUrl,
        fragmentPath: button.getAttribute('data-git-fragment') || '',
        filesFragment: button.getAttribute('data-git-files') || '',
        refsFragment: button.getAttribute('data-git-refs') || '',
        readmeFragment: button.getAttribute('data-git-readme') || '',
        commitsJsonPath: button.getAttribute('data-git-commits') || '',
        fullLogFragment: fullLogFragment,
        limitedLogFragment: limitedLogFragment,
        logInitialLimit: logInitialLimit,
        logTotalCommits: logTotalCommits,
        logFragmentOverride: '',
        label: label,
        searchText: searchText.toLowerCase()
      };
    });

    var repoListEl = document.getElementById('git-repo-list');
    var emptyStateEl = document.getElementById('git-empty');
    var searchInput = document.getElementById('git-search-input');
    var panelContainer = document.getElementById('git-panel-container');
    var panelSlot = document.getElementById('git-panel-slot');
    var detailIndicator = document.getElementById('git-detail-indicator');
    var activeLabel = document.getElementById('git-active-repo-label');

    var tabButtons = Array.prototype.slice.call(document.querySelectorAll('.git-tab-button'));
    var tabMap = {};
    tabButtons.forEach(function(button) {
      var tab = button.getAttribute('data-git-tab');
      if (!tab) {
        return;
      }
      tabMap[tab] = button;
    });

    var gitShell = document.querySelector('.git-shell');
    var sidebar = document.getElementById('git-sidebar');
    var sidebarToggle = document.getElementById('git-sidebar-toggle');
    var orientationOverlay = document.getElementById('git-orientation-overlay');
    var orientationMobileQuery = typeof window.matchMedia === 'function'
      ? window.matchMedia('(max-width: 1024px)')
      : null;
    var orientationPortraitQuery = typeof window.matchMedia === 'function'
      ? window.matchMedia('(orientation: portrait)')
      : null;
    var orientationOverlayVisible = false;
    var orientationOverlayLockClass = 'git-orientation-locked';
    var orientationOverlayVisibleClass = 'is-visible';
    var orientationBypassTapCount = 0;
    var orientationBypassTapThreshold = 7;
    var orientationBypassResetDelay = 2200;
    var orientationBypassResetTimer = null;
    var orientationBypassActive = false;
    var orientationOverlaySupportsPointer = typeof window !== 'undefined' && typeof window.PointerEvent === 'function';

    var activeEntry = null;
    var activeButton = null;
    var activeTab = 'log';
    var pendingController = null;
    var pendingFileController = null;
    var activeFileButton = null;
    var sidebarCollapsed = false;
    var sidebarAutoCollapsed = false;
    var pendingPermalinkState = null;

    function attachMediaQueryListener(query, handler) {
      if (!query || typeof handler !== 'function') {
        return;
      }
      if (typeof query.addEventListener === 'function') {
        query.addEventListener('change', handler);
      } else if (typeof query.addListener === 'function') {
        query.addListener(handler);
      }
    }

    function setOrientationOverlayVisible(visible) {
      if (!orientationOverlay) {
        return;
      }
      if (visible === orientationOverlayVisible) {
        return;
      }
      orientationOverlayVisible = visible;
      var body = document.body || document.documentElement;
      orientationOverlay.classList.toggle(orientationOverlayVisibleClass, visible);
      orientationOverlay.setAttribute('aria-hidden', visible ? 'false' : 'true');
      if (body) {
        body.classList.toggle(orientationOverlayLockClass, visible);
      }
      if (!visible) {
        resetOrientationBypassCounter();
      }
    }

    function clearOrientationBypassReset() {
      if (orientationBypassResetTimer) {
        window.clearTimeout(orientationBypassResetTimer);
        orientationBypassResetTimer = null;
      }
    }

    function resetOrientationBypassCounter() {
      orientationBypassTapCount = 0;
      clearOrientationBypassReset();
    }

    function scheduleOrientationBypassReset() {
      clearOrientationBypassReset();
      orientationBypassResetTimer = window.setTimeout(function() {
        resetOrientationBypassCounter();
      }, orientationBypassResetDelay);
    }

    function handleOrientationOverlayTap(event) {
      if (!orientationOverlayVisible || orientationBypassActive) {
        return;
      }
      if (event && (event.isPrimary === false || (event.type === 'pointerup' && event.button !== 0))) {
        return;
      }
      if (event && typeof event.preventDefault === 'function') {
        event.preventDefault();
      }
      orientationBypassTapCount += 1;
      if (orientationBypassTapCount >= orientationBypassTapThreshold) {
        resetOrientationBypassCounter();
        orientationBypassActive = true;
        setOrientationOverlayVisible(false);
        return;
      }
      scheduleOrientationBypassReset();
    }

    function evaluateOrientationOverlay() {
      if (!orientationOverlay) {
        return;
      }
      if (orientationBypassActive) {
        setOrientationOverlayVisible(false);
        return;
      }
      var isMobileViewport = orientationMobileQuery ? orientationMobileQuery.matches : window.innerWidth <= 1024;
      var isPortraitOrientation = orientationPortraitQuery ? orientationPortraitQuery.matches : window.innerHeight >= window.innerWidth;
      setOrientationOverlayVisible(isMobileViewport && isPortraitOrientation);
    }

    function escapeHtml(value) {
      if (value == null) {
        return '';
      }
      return value
        .toString()
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function buildEntryKey(entry) {
      if (!entry) {
        return '';
      }
      return entry.id || entry.detailUrl || entry.label || '';
    }

    function resolveRelative(pathValue) {
      if (!pathValue) return '';
      if (/^(?:[a-z]+:)?\/\//i.test(pathValue)) {
        return pathValue;
      }
      if (pathValue.startsWith('/')) {
        return pathValue;
      }
      if (pathValue.startsWith('./') || pathValue.startsWith('../')) {
        return pathValue;
      }
      return './' + pathValue;
    }

    function fallbackCopyText(text) {
      return new Promise(function(resolve) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('aria-hidden', 'true');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        var succeeded = false;
        try {
          succeeded = document.execCommand('copy');
        } catch (copyError) {
          console.warn('Copy failed', copyError);
        }
        document.body.removeChild(textarea);
        resolve(!!succeeded);
      });
    }

    function copyTextToClipboard(text) {
      if (!text) {
        return Promise.resolve(false);
      }
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        return navigator.clipboard.writeText(text).then(function() {
          return true;
        }).catch(function() {
          return fallbackCopyText(text);
        });
      }
      return fallbackCopyText(text);
    }

    function flashCopyFeedback(target, message, duration) {
      if (!target) {
        return;
      }
      if (typeof document === 'undefined') {
        return;
      }
      var bubble = target.__gitCopyBubble;
      if (!bubble || !document.body.contains(bubble)) {
        bubble = document.createElement('span');
        bubble.className = 'git-copy-feedback';
        bubble.setAttribute('aria-hidden', 'true');
        document.body.appendChild(bubble);
        target.__gitCopyBubble = bubble;
      }
      var rect = target.getBoundingClientRect();
      bubble.textContent = message || 'Copied!';
      bubble.classList.remove('is-visible');
      if (bubble.__gitHideTimer) {
        window.clearTimeout(bubble.__gitHideTimer);
      }
      var schedule =
        typeof window !== 'undefined' && typeof window.requestAnimationFrame === 'function'
          ? window.requestAnimationFrame.bind(window)
          : function(callback) {
              return setTimeout(callback, 16);
            };
      var top = Math.max(rect.top, 0);
      var left = rect.left + rect.width / 2;
      bubble.style.top = top + 'px';
      bubble.style.left = left + 'px';
      schedule(function() {
        bubble.classList.add('is-visible');
      });
      var timeout = Number.isFinite(duration) ? duration : 1600;
      bubble.__gitHideTimer = window.setTimeout(function() {
        bubble.classList.remove('is-visible');
      }, timeout);
    }

    function buildBlobPermalink(fragmentPath, lineNumber) {
      if (!fragmentPath || !lineNumber) {
        return '';
      }
      var baseHref = window.location.href.split('#')[0];
      var repoKey = panelSlot
        ? (panelSlot.getAttribute('data-git-active-entry-key') || panelSlot.getAttribute('data-git-active-entry') || '')
        : '';
      if (!repoKey) {
        var slugMatch = fragmentPath.match(/^git\/([^/]+)/);
        if (slugMatch && slugMatch[1]) {
          repoKey = slugMatch[1];
        }
      }
      var activeTab = panelSlot ? (panelSlot.getAttribute('data-git-active-tab') || '') : '';
      if (!activeTab) {
        activeTab = 'files';
      }
      var params = new URLSearchParams();
      if (repoKey) {
        params.set('repo', repoKey);
      }
      if (activeTab) {
        params.set('tab', activeTab);
      }
      params.set('blob', fragmentPath);
      params.set('line', lineNumber);
      return baseHref + '#' + params.toString();
    }

    function showIndicator(message) {
      if (!detailIndicator) return;
      detailIndicator.hidden = false;
      detailIndicator.removeAttribute('aria-hidden');
      detailIndicator.classList.remove('is-hidden');
      detailIndicator.textContent = message || 'Loading…';
    }

    function hideIndicator() {
      if (!detailIndicator) return;
      detailIndicator.hidden = true;
      detailIndicator.setAttribute('aria-hidden', 'true');
      detailIndicator.classList.add('is-hidden');
    }

    function renderPanelMessage(kind, htmlMessage) {
      return '<div class="git-panel-message git-panel-message--' + kind + '">' + htmlMessage + '</div>';
    }

    function setPanelMetadata(entry, tab, fragment) {
      if (!panelSlot) {
        return;
      }
      var entryKey = buildEntryKey(entry);
      var entryLabel = entry && entry.label ? entry.label : '';
      var entryUrl = entry && entry.detailUrl ? entry.detailUrl : '';
      panelSlot.setAttribute('data-git-active-entry', entryKey);
      panelSlot.setAttribute('data-git-active-entry-key', entryKey);
      panelSlot.setAttribute('data-git-active-entry-label', entryLabel);
      panelSlot.setAttribute('data-git-active-entry-url', entryUrl);
      panelSlot.setAttribute('data-git-active-tab', tab || '');
      panelSlot.setAttribute('data-git-active-fragment', fragment || '');
    }

    function setPanelContent(html, tab) {
      if (!panelSlot) {
        return;
      }
      panelSlot.innerHTML = html;
      enhancePanel(tab);
      enableCloneCopy(panelSlot);
    }

    function setPanelError(entry, tab, error) {
      var message = error && error.message ? error.message : 'Unable to load this view.';
      var linkHtml = '';
      if (entry && entry.detailUrl && tab === 'log') {
        linkHtml = ' <a href="' + escapeHtml(entry.detailUrl) + '" target="_blank" rel="noopener">Open full log</a>.';
      }
      setPanelContent(renderPanelMessage('error', escapeHtml(message) + linkHtml), tab);
    }

    function setPanelUnavailable(entry, tab) {
      var label = TAB_LABELS[tab] || 'view';
      var linkHtml = '';
      if (entry && entry.detailUrl && tab === 'log') {
        linkHtml = ' <a href="' + escapeHtml(entry.detailUrl) + '" target="_blank" rel="noopener">Open full log</a>.';
      } else if (entry && entry.detailUrl) {
        linkHtml = ' <a href="' + escapeHtml(entry.detailUrl) + '" target="_blank" rel="noopener">View on origin</a>.';
      }
      var message = 'No ' + escapeHtml(label) + ' is available for this repository.' + linkHtml;
      setPanelContent(renderPanelMessage('empty', message), tab);
    }

    function setActiveButton(button) {
      if (activeButton && activeButton !== button) {
        activeButton.classList.remove('git-link-active');
      }
      activeButton = button || null;
      if (activeButton) {
        activeButton.classList.add('git-link-active');
      }
    }

    function enableCloneCopy(root) {
      if (!root || typeof window === 'undefined') {
        return;
      }
      var buttons = Array.prototype.slice.call(root.querySelectorAll('.git-clone-copy'));
      buttons.forEach(function(button) {
        if (button.getAttribute('data-copy-bound') === 'true') {
          return;
        }
        button.setAttribute('data-copy-bound', 'true');
        button.addEventListener('click', function(event) {
          event.preventDefault();
          var commandElement = null;
          if (button.getAttribute('data-copy-source') === 'previous') {
            var previous = button.previousElementSibling;
            if (previous && previous.classList.contains('git-clone-command')) {
              commandElement = previous;
            }
          }
          if (!commandElement) {
            var cloneRoot = button.closest('.git-panel-clone');
            if (cloneRoot) {
              commandElement = cloneRoot.querySelector('.git-clone-command');
            }
          }
          var commandText = commandElement ? commandElement.textContent.trim() : '';
          if (!commandText) {
            return;
          }
          copyTextToClipboard(commandText).then(function(success) {
            if (!success) {
              return;
            }
            button.classList.add('is-copied');
            flashCopyFeedback(button, 'Copied!');
            window.setTimeout(function() {
              button.classList.remove('is-copied');
            }, 1600);
          });
        });
      });
    }

    function filterList(query) {
      var needle = (query || '').trim().toLowerCase();
      var matches = 0;
      repoItems.forEach(function(entry) {
        var li = entry.button.closest('.git-repo-list-item');
        if (!li) {
          return;
        }
        var isMatch = !needle || entry.searchText.indexOf(needle) !== -1;
        li.hidden = !isMatch;
        if (isMatch) {
          matches += 1;
        }
      });
      if (emptyStateEl) {
        emptyStateEl.hidden = matches > 0;
      }
    }

    function findEntry(predicate) {
      for (var i = 0; i < repoItems.length; i += 1) {
        if (predicate(repoItems[i])) {
          return repoItems[i];
        }
      }
      return null;
    }

    function findEntryByUrl(url) {
      if (!url) return null;
      return findEntry(function(entry) {
        return entry.detailUrl === url;
      });
    }

    function findEntryByLabel(label) {
      if (!label) return null;
      var target = label.toLowerCase();
      return findEntry(function(entry) {
        return (entry.label || '').toLowerCase() === target;
      });
    }

    function findEntryByFragment(fragment) {
      if (!fragment) return null;
      return findEntry(function(entry) {
        return entry.fragmentPath === fragment || entry.fullLogFragment === fragment;
      });
    }

    function getFragmentForTab(entry, tab) {
      if (!entry) return '';
      if (tab === 'log') {
        return entry.fragmentPath || '';
      }
      if (tab === 'files') {
        return entry.filesFragment || '';
      }
      if (tab === 'refs') {
        return entry.refsFragment || '';
      }
      if (tab === 'readme') {
        return entry.readmeFragment || '';
      }
      return '';
    }

    function updateTabAvailability(entry) {
      TAB_ORDER.forEach(function(tab) {
        var button = tabMap[tab];
        if (!button) {
          return;
        }
        var fragment = getFragmentForTab(entry, tab);
        var isAvailable = tab === 'log' ? true : !!fragment;
        button.disabled = !isAvailable;
        button.classList.toggle('is-disabled', !isAvailable);
      });
    }

    function setActiveTab(tab) {
      Object.keys(tabMap).forEach(function(key) {
        var button = tabMap[key];
        if (!button) return;
        var isActive = key === tab;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function abortPendingFileRequest() {
      if (pendingFileController && typeof pendingFileController.abort === 'function') {
        pendingFileController.abort();
      }
      pendingFileController = null;
    }

    function abortPendingRequest() {
      if (pendingController && typeof pendingController.abort === 'function') {
        pendingController.abort();
      }
      pendingController = null;
      abortPendingFileRequest();
    }

    function setSidebarCollapsed(collapsed, options) {
      options = options || {};
      sidebarCollapsed = collapsed;
      if (options.reason === 'auto') {
        sidebarAutoCollapsed = collapsed;
      } else if (options.reason === 'manual') {
        sidebarAutoCollapsed = false;
      } else if (!collapsed) {
        sidebarAutoCollapsed = false;
      }
      if (gitShell) {
        gitShell.classList.toggle('is-sidebar-collapsed', collapsed);
      }
      if (sidebar) {
        sidebar.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
      }
      if (sidebarToggle) {
        sidebarToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        sidebarToggle.textContent = collapsed ? 'Show repos' : 'Hide repos';
      }
    }

    function enhancePanel(tab) {
      if (tab === 'files') {
        activeFileButton = null;
        initFilesPanel();
      } else {
        activeFileButton = null;
      }
      if (tab === 'log') {
        initLogPanel();
      }
    }

    function setActiveFileButton(button) {
      if (activeFileButton && activeFileButton !== button) {
        activeFileButton.classList.remove('is-active');
      }
      activeFileButton = button || null;
      if (activeFileButton) {
        activeFileButton.classList.add('is-active');
      }
    }

    function expandTreeAncestors(element) {
      if (!element) {
        return;
      }
      var current = element.parentElement;
      while (current) {
        if (current.tagName && current.tagName.toLowerCase() === 'details') {
          current.open = true;
        }
        current = current.parentElement;
      }
    }

    function loadBlobPreview(blobPath, sourceButton) {
      if (!panelSlot) {
        return;
      }
      var preview = panelSlot.querySelector('[data-git-file-preview]');
      if (!preview) {
        return;
      }
      if (panelSlot) {
        panelSlot.setAttribute('data-git-active-blob', blobPath || '');
      }
      abortPendingFileRequest();
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      if (controller) {
        pendingFileController = controller;
      }
      preview.innerHTML = renderPanelMessage('loading', 'Loading file…');
      var requestUrl = resolveRelative(blobPath);
      fetch(requestUrl, controller ? { signal: controller.signal } : {})
        .then(function(response) {
          if (!response.ok) {
            throw new Error('Request failed with status ' + response.status);
          }
          return response.text();
        })
        .then(function(html) {
          if (controller && controller.signal.aborted) {
            return;
          }
          preview.innerHTML = html;
          enableCloneCopy(preview);
          enhanceBlobPreview(preview);
        })
        .catch(function(error) {
          if (controller && controller.signal.aborted) {
            return;
          }
          preview.innerHTML = renderPanelMessage('error', escapeHtml(error.message || 'Unable to load file preview.'));
        })
        .finally(function() {
          if (pendingFileController === controller) {
            pendingFileController = null;
          }
        });
      setActiveFileButton(sourceButton || null);
    }

    function initFilesPanel() {
      if (!panelSlot) {
        return;
      }
      var activeEntryKey = panelSlot.getAttribute('data-git-active-entry-key') || '';
      var treeButtons = Array.prototype.slice.call(panelSlot.querySelectorAll('.git-tree-entry'));
      if (treeButtons.length === 0) {
        return;
      }
      treeButtons.forEach(function(button) {
        button.addEventListener('click', function(event) {
          event.preventDefault();
          var blobPath = button.getAttribute('data-git-blob') || '';
          if (!blobPath) {
            return;
          }
          loadBlobPreview(blobPath, button);
        });
      });
      if (
        pendingPermalinkState &&
        pendingPermalinkState.repoKey &&
        pendingPermalinkState.repoKey === activeEntryKey &&
        pendingPermalinkState.blob
      ) {
        var targetBlobPath = pendingPermalinkState.blob;
        var targetButton = null;
        treeButtons.forEach(function(button) {
          if (targetButton) {
            return;
          }
          if ((button.getAttribute('data-git-blob') || '') === targetBlobPath) {
            targetButton = button;
          }
        });
        if (targetButton) {
          expandTreeAncestors(targetButton);
          loadBlobPreview(targetBlobPath, targetButton);
        }
      }
      var preview = panelSlot.querySelector('[data-git-file-preview]');
      if (preview) {
        preview.setAttribute('tabindex', '-1');
      }
    }

    function initLogPanel() {
      if (!panelSlot) {
        return;
      }
      var panel = panelSlot.querySelector('.git-panel');
      if (!panel) {
        return;
      }
      var expandLink = panel.querySelector('[data-git-log-action="expand"]');
      if (expandLink && expandLink.getAttribute('data-git-bound') !== 'true') {
        expandLink.setAttribute('data-git-bound', 'true');
        expandLink.addEventListener('click', function(event) {
          event.preventDefault();
          if (!activeEntry) {
            return;
          }
          var fragment = expandLink.getAttribute('href') || panel.getAttribute('data-git-full-fragment') || '';
          if (!fragment && activeEntry.fullLogFragment) {
            fragment = activeEntry.fullLogFragment;
          }
          if (!fragment) {
            fragment = getFragmentForTab(activeEntry, 'log');
          }
          if (!fragment) {
            return;
          }
          loadPanel(activeEntry, 'log', {
            forceReload: true,
            fragmentOverride: fragment,
            rememberFragment: true
          });
        });
      }
      var collapseLink = panel.querySelector('[data-git-log-action="collapse"]');
      if (collapseLink && collapseLink.getAttribute('data-git-bound') !== 'true') {
        collapseLink.setAttribute('data-git-bound', 'true');
        collapseLink.addEventListener('click', function(event) {
          event.preventDefault();
          if (!activeEntry) {
            return;
          }
          var fragment = collapseLink.getAttribute('href') || panel.getAttribute('data-git-limited-fragment') || '';
          if (!fragment) {
            fragment = activeEntry.limitedLogFragment || activeEntry.fragmentPath || '';
          }
          if (!fragment) {
            fragment = getFragmentForTab(activeEntry, 'log');
          }
          if (!fragment) {
            return;
          }
          loadPanel(activeEntry, 'log', {
            forceReload: true,
            fragmentOverride: fragment,
            rememberFragment: false
          });
        });
      }
    }

    function enhanceBlobPreview(root) {
      if (!root) {
        return;
      }
      var panel = root.querySelector('[data-git-panel-section="blob"]');
      if (!panel) {
        return;
      }

      var rawPath = panel.getAttribute('data-git-raw-path') || '';
      var fragmentPath = panel.getAttribute('data-git-fragment-path') || '';

      var copyButton = panel.querySelector('[data-git-file-copy]');
      if (copyButton && copyButton.getAttribute('data-copy-bound') !== 'true') {
        copyButton.setAttribute('data-copy-bound', 'true');
        if (!rawPath) {
          copyButton.disabled = true;
        } else {
          copyButton.addEventListener('click', function(event) {
            event.preventDefault();
            if (copyButton.getAttribute('data-copy-loading') === 'true') {
              return;
            }
            var cached = copyButton.__gitRawCache;
            var handleCopy = function(text) {
              if (!text) {
                return;
              }
              copyTextToClipboard(text).then(function(success) {
                if (!success) {
                  return;
                }
                copyButton.classList.add('is-copied');
                flashCopyFeedback(copyButton, 'Copied!');
                window.setTimeout(function() {
                  copyButton.classList.remove('is-copied');
                }, 1600);
              });
            };
            if (typeof cached === 'string') {
              handleCopy(cached);
              return;
            }
            copyButton.setAttribute('data-copy-loading', 'true');
            copyButton.classList.add('is-loading');
            var requestUrl = resolveRelative(rawPath);
            fetch(requestUrl)
              .then(function(response) {
                if (!response.ok) {
                  throw new Error('Request failed with status ' + response.status);
                }
                return response.text();
              })
              .then(function(text) {
                copyButton.__gitRawCache = text;
                handleCopy(text);
              })
              .catch(function(error) {
                console.warn('Unable to copy file contents', error);
              })
              .finally(function() {
                copyButton.classList.remove('is-loading');
                copyButton.removeAttribute('data-copy-loading');
              });
          });
        }
      }

      var highlightedLine = null;
      var highlightedButton = null;

      function setHighlightedLine(lineNumber, sourceButton) {
        if (highlightedLine) {
          highlightedLine.classList.remove('is-highlighted');
        }
        if (highlightedButton) {
          highlightedButton.classList.remove('is-highlighted');
        }
        var targetLine = panel.querySelector('#L' + lineNumber);
        if (targetLine) {
          targetLine.classList.add('is-highlighted');
          try {
            targetLine.scrollIntoView({ block: 'nearest' });
          } catch (scrollError) {
            // noop
          }
          highlightedLine = targetLine;
        } else {
          highlightedLine = null;
        }
        if (sourceButton) {
          sourceButton.classList.add('is-highlighted');
          highlightedButton = sourceButton;
        } else {
          highlightedButton = null;
        }
      }

      var lineButtons = Array.prototype.slice.call(panel.querySelectorAll('[data-git-line-anchor]'));
      lineButtons.forEach(function(button) {
        if (button.getAttribute('data-copy-bound') === 'true') {
          return;
        }
        button.setAttribute('data-copy-bound', 'true');
        button.addEventListener('click', function(event) {
          event.preventDefault();
          var lineNumber = button.getAttribute('data-git-line-anchor');
          if (!lineNumber) {
            return;
          }
          setHighlightedLine(lineNumber, button);
          if (!fragmentPath) {
            return;
          }
          var permalink = buildBlobPermalink(fragmentPath, lineNumber);
          if (!permalink) {
            return;
          }
          copyTextToClipboard(permalink).then(function(success) {
            if (!success) {
              return;
            }
            button.classList.add('is-copied');
            flashCopyFeedback(button, 'Permalink copied!');
            window.setTimeout(function() {
              button.classList.remove('is-copied');
            }, 1600);
          });
        });
      });

      if (pendingPermalinkState) {
        var activeEntryKey = panelSlot ? panelSlot.getAttribute('data-git-active-entry-key') : '';
        var targetRepoKey = pendingPermalinkState.repoKey || '';
        var targetBlobPath = pendingPermalinkState.blob || '';
        var targetLine = pendingPermalinkState.line || '';
        var panelBlobPath = panel.getAttribute('data-git-fragment-path') || '';
        if (
          activeEntryKey &&
          targetRepoKey &&
          activeEntryKey === targetRepoKey &&
          panelBlobPath &&
          targetBlobPath &&
          panelBlobPath === targetBlobPath
        ) {
          if (targetLine) {
            var targetButton = panel.querySelector('[data-git-line-anchor="' + targetLine + '"]');
            setHighlightedLine(targetLine, targetButton);
          }
          pendingPermalinkState = null;
        }
      }
    }

    function parseLocationHash() {
      if (typeof window === 'undefined') {
        return null;
      }
      var hash = window.location.hash || '';
      if (!hash || hash.length <= 1) {
        return null;
      }
      var params = new URLSearchParams(hash.slice(1));
      var state = {};
      var hasValue = false;
      ['repo', 'tab', 'blob', 'line'].forEach(function(key) {
        var value = params.get(key);
        if (value != null && value !== '') {
          state[key] = value;
          hasValue = true;
        }
      });
      return hasValue ? state : null;
    }

    function restoreLocationState() {
      var state = parseLocationHash();
      if (!state) {
        pendingPermalinkState = null;
        return false;
      }
      var repoKey = state.repo || '';
      var blobPath = state.blob || '';
      var tab = state.tab || (blobPath ? 'files' : '');
      var lineRaw = state.line || '';
      var line = lineRaw.replace(/[^\d]/g, '');

      var targetEntry = null;
      if (repoKey) {
        targetEntry = findEntry(function(entry) {
          return buildEntryKey(entry) === repoKey;
        });
      }
      if (!targetEntry && blobPath) {
        var slugMatch = blobPath.match(/^git\/([^/]+)/);
        if (slugMatch && slugMatch[1]) {
          var slugId = slugMatch[1];
          targetEntry = findEntry(function(entry) {
            return (entry.id && entry.id === slugId) || buildEntryKey(entry) === slugId;
          });
        }
      }
      if (!targetEntry && blobPath) {
        targetEntry = findEntryByFragment(blobPath);
      }
      if (!targetEntry) {
        pendingPermalinkState = null;
        return false;
      }

      var resolvedTab = tab || 'readme';
      if (blobPath) {
        resolvedTab = 'files';
      }

      if (
        activeEntry === targetEntry &&
        blobPath &&
        panelSlot &&
        (panelSlot.getAttribute('data-git-active-blob') || '') === blobPath
      ) {
        pendingPermalinkState = {
          repoKey: buildEntryKey(targetEntry),
          blob: blobPath,
          line: line,
          tab: resolvedTab
        };
        enhanceBlobPreview(panelSlot);
        return true;
      }

      pendingPermalinkState = {
        repoKey: buildEntryKey(targetEntry),
        blob: blobPath,
        line: line,
        tab: resolvedTab
      };

      activateEntry(targetEntry, { tab: resolvedTab, forceReload: true });
      return true;
    }

    function loadPanel(entry, tab, options) {
      if (!entry) {
        return;
      }
      options = options || {};
      if (tab === 'files' && !sidebarCollapsed) {
        setSidebarCollapsed(true, { reason: 'auto' });
      } else if (tab !== 'files' && sidebarAutoCollapsed && sidebarCollapsed) {
        setSidebarCollapsed(false, { reason: 'auto' });
      }

      var fragmentOverride = options.fragmentOverride || '';
      if (!fragmentOverride && tab === 'log' && entry.logFragmentOverride) {
        fragmentOverride = entry.logFragmentOverride;
      }
      if (tab === 'log' && !entry.limitedLogFragment) {
        entry.limitedLogFragment = entry.fragmentPath || '';
      }
      var fragment = fragmentOverride || getFragmentForTab(entry, tab);
      if (tab === 'log') {
        if (options.rememberFragment === true && fragmentOverride) {
          entry.logFragmentOverride = fragmentOverride;
        } else if (options.rememberFragment === false) {
          entry.logFragmentOverride = '';
        }
      }
      setPanelMetadata(entry, tab, fragment);
      if (!fragment) {
        hideIndicator();
        setActiveTab(tab);
        setPanelUnavailable(entry, tab);
        activeTab = tab;
        return;
      }

      abortPendingRequest();
      setActiveTab(tab);
      activeTab = tab;
      var label = entry.label || entry.detailUrl || 'Repository';
      showIndicator('Loading ' + label + ' · ' + (TAB_LABELS[tab] || 'view') + '…');
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      if (controller) {
        pendingController = controller;
      }
      var requestUrl = resolveRelative(fragment);
      if (options.forceReload) {
        var separator = requestUrl.indexOf('?') === -1 ? '?' : '&';
        requestUrl = requestUrl + separator + 'ts=' + Date.now();
      }
      fetch(requestUrl, controller ? { signal: controller.signal } : {})
        .then(function(response) {
          if (!response.ok) {
            throw new Error('Request failed with status ' + response.status);
          }
          return response.text();
        })
        .then(function(html) {
          if (controller && controller.signal.aborted) {
            return;
          }
          hideIndicator();
          setPanelContent(html, tab);
        })
        .catch(function(error) {
          if (controller && controller.signal.aborted) {
            return;
          }
          hideIndicator();
          setPanelError(entry, tab, error);
        })
        .finally(function() {
          if (pendingController === controller) {
            pendingController = null;
          }
        });
    }

    function resolveTab(entry, desired) {
      var order = [];
      if (desired) {
        order.push(desired);
      }
      TAB_ORDER.forEach(function(tab) {
        if (order.indexOf(tab) === -1) {
          order.push(tab);
        }
      });
      for (var i = 0; i < order.length; i += 1) {
        var candidate = order[i];
        if (candidate === 'log') {
          return 'log';
        }
        if (getFragmentForTab(entry, candidate)) {
          return candidate;
        }
      }
      return 'log';
    }

    function activateEntry(entry, options) {
      if (!entry) {
        return;
      }
      options = options || {};
      var forceReload = !!options.forceReload;
      var requestedTab = typeof options.tab === 'string' ? options.tab : null;
      var previousEntry = activeEntry;
      var isSameEntry = previousEntry === entry;

      if (isSameEntry && !forceReload && !requestedTab) {
        return;
      }

      activeEntry = entry;
      setActiveButton(entry.button);
      if (activeLabel) {
        activeLabel.textContent = entry.label || entry.detailUrl || 'selected repository';
      }

      updateTabAvailability(entry);

      var targetTab;
      if (requestedTab) {
        targetTab = requestedTab;
      } else if (!isSameEntry) {
        targetTab = 'log';
      } else {
        targetTab = activeTab;
      }

      var nextTab = resolveTab(entry, targetTab);
      loadPanel(entry, nextTab, { forceReload: forceReload });
    }

    repoButtons.forEach(function(button) {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        var entry = findEntry(function(candidate) {
          return candidate.button === button;
        });
        activateEntry(entry, {});
      });
    });

    tabButtons.forEach(function(button) {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        var tab = button.getAttribute('data-git-tab');
        if (!tab || button.disabled) {
          return;
        }
        if (!activeEntry) {
          return;
        }
        if (tab === activeTab && !button.classList.contains('is-disabled')) {
          return;
        }
        loadPanel(activeEntry, tab, { forceReload: false });
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function(event) {
        filterList(event.target.value || '');
      });
    }

    if (sidebarToggle) {
      sidebarToggle.addEventListener('click', function(event) {
        event.preventDefault();
        var nextCollapsed = !sidebarCollapsed;
        setSidebarCollapsed(nextCollapsed, { reason: 'manual' });
      });
    }

    setSidebarCollapsed(false);
    filterList('');

    var initialFragment = panelContainer ? panelContainer.getAttribute('data-default-fragment') : '';
    var initialUrl = panelContainer ? panelContainer.getAttribute('data-default-url') : '';
    var initialName = panelContainer ? panelContainer.getAttribute('data-default-name') : '';
    var initialEntry =
      findEntryByFragment(initialFragment) ||
      findEntryByUrl(initialUrl) ||
      findEntryByLabel(initialName) ||
      repoItems[0] ||
      null;

    var locationStateApplied = restoreLocationState();
    if (!locationStateApplied) {
      if (initialEntry) {
        activateEntry(initialEntry, {});
      } else {
        hideIndicator();
      }
    }

    if (orientationOverlay) {
      if (orientationOverlaySupportsPointer) {
        orientationOverlay.addEventListener('pointerup', handleOrientationOverlayTap);
      } else {
        orientationOverlay.addEventListener('click', handleOrientationOverlayTap);
      }
      evaluateOrientationOverlay();
      attachMediaQueryListener(orientationMobileQuery, evaluateOrientationOverlay);
      attachMediaQueryListener(orientationPortraitQuery, evaluateOrientationOverlay);
      window.addEventListener('resize', evaluateOrientationOverlay);
      window.addEventListener('orientationchange', evaluateOrientationOverlay);
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) {
          evaluateOrientationOverlay();
        }
      });
    }

    window.addEventListener('hashchange', restoreLocationState);
  })();
</script>
