<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= site.title %> – <%= page.title %></title>

  <%- include('../partials/cm-head.ejs') %>

  <% const rootBase = page.rootBase || (site.baseUrl && site.baseUrl !== '/' ? site.baseUrl.replace(/\/$/, '') : ''); %>
  <% const isExternal = (href) => /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(href || ''); %>
  <% const buildInternalHref = (href) => {
       if (!href) return '#';
       if (isExternal(href)) return href;
       if (href.startsWith('#')) {
         const target = href.slice(1);
         return target ? `${rootBase}/sections/${target}.html` : `${rootBase}/`;
       }
       const cleaned = href.replace(/^\/+/, '');
       return `${rootBase}/${cleaned}`;
     }; %>
  <% const buildAssetHref = (asset) => {
       if (!asset) return '';
       if (isExternal(asset)) return asset;
       if (asset.startsWith('/')) {
         return `${rootBase}${asset}`;
       }
       return `${rootBase}/${asset.replace(/^\/+/, '')}`;
     }; %>
  <% const highlightFirstPost = page.initialPost && !page.isDefaultInitialPost && !page.isHiddenInitialPost; %>

</head>
<body class="cm-body blog-page">
  <header>
    <div class="container header-container">
      <% const logoPath = site.logo || 'assets/static/img/not-dead.webp'; %>
      <% const resolvedLogo = buildAssetHref(logoPath); %>
      <% if (resolvedLogo) { %>
        <a href="<%= buildInternalHref('index.html') %>" class="logo-link">
          <img src="<%= resolvedLogo %>" alt="<%= site.title %> Logo" class="logo">
        </a>
      <% } else { %>
        <h1 class="logo-text"><%= site.title %></h1>
      <% } %>
      <% var navLinks = (site.header && site.header.links) ? site.header.links : []; %>
      <% if (navLinks.length > 0) { %>
        <button type="button" class="nav-toggle" aria-label="Toggle navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7h18M3 12h18M3 17h18" />
          </svg>
        </button>
        <nav class="main-nav">
          <ul class="nav-links">
            <% navLinks.forEach(function(link) { %>
              <li><a href="<%= buildInternalHref(link.href) %>"><%= link.label %></a></li>
            <% }); %>
            <li><button type="button" class="theme-toggle" aria-label="Toggle contrast" title="Toggle contrast">◎</button></li>
          </ul>
        </nav>
      <% } %>
    </div>
  </header>

  <main class="blog-container">
    <section class="blog-hero-slab">
      <h2 class="blog-hero-title"><%= page.hero?.title || page.title %></h2>
      <% if (page.hero && page.hero.tagline) { %>
        <p class="blog-hero-tagline"><%= page.hero.tagline %></p>
      <% } %>
      <% if (page.hero && page.hero.intro) { %>
        <p class="blog-hero-intro"><%= page.hero.intro %></p>
      <% } %>
    </section>

    <section class="blog-layout">
      <aside class="blog-sidebar" aria-label="Blog post list" data-page-size="<%= page.sidebarPageSize || 6 %>">
        <h3 class="blog-sidebar-title">Posts</h3>
        <% if (page.authorFilter && page.authors && page.authors.length > 0) { %>
          <div class="blog-author-filter" role="group" aria-label="Filter posts by author">
            <button type="button" class="author-filter-btn is-active" data-author-filter="all">All</button>
            <% page.authors.forEach(function(author) { %>
              <button type="button" class="author-filter-btn" data-author-filter="<%= author.id %>"><%= author.name %></button>
            <% }); %>
          </div>
        <% } %>
        <div class="blog-sidebar-search">
          <label class="visually-hidden" for="blog-search-input">Search posts</label>
          <input
            id="blog-search-input"
            type="search"
            class="post-search-input"
            placeholder="Search posts..."
            autocomplete="off"
            spellcheck="false"
          >
        </div>
        <ul class="blog-post-list">
          <% page.posts.forEach(function(post, index) { %>
            <li data-post-item data-author="<%= post.author ? post.author.id : 'unknown' %>" data-title="<%= post.title.toLowerCase() %>" data-summary="<%= (post.summary || '').toLowerCase() %>">
              <a
                class="blog-post-link<%= highlightFirstPost && index === 0 ? ' is-active' : '' %>"
                href="<%= post.publicHref || buildInternalHref(post.relativeHref) %>"
                data-post-slug="<%= post.slug %>"
                hx-get="<%= post.fragmentHref %>"
                hx-trigger="click"
                hx-target="#blog-article"
                hx-swap="innerHTML"
                hx-push-url="true"
                hx-indicator="#blog-loading"
              >
                <h3><%= post.title %></h3>
                <div class="blog-post-meta">
                  <% if (post.displayPublishedAt) { %>
                    <span><%= post.displayPublishedAt %></span>
                  <% } %>
                  <% if (post.readingMinutes) { %>
                    <span aria-hidden="true">•</span>
                    <span><%= post.readingMinutes %> min read</span>
                  <% } %>
                  <% if (post.author) { %>
                    <span aria-hidden="true">•</span>
                    <span><%= post.author.name %></span>
                  <% } %>
                </div>
                <% if (post.summary) { %>
                  <p><%= post.summary %></p>
                <% } %>
              </a>
            </li>
          <% }); %>
          <% if (page.hiddenPosts && page.hiddenPosts.length > 0) { %>
            <% page.hiddenPosts.forEach(function(post) { %>
              <li
                data-post-item
                data-hidden="true"
                data-author="<%= post.author ? post.author.id : 'unknown' %>"
                data-title="<%= post.title ? post.title.toLowerCase() : '' %>"
                data-summary="<%= (post.summary || '').toLowerCase() %>"
              >
                <a
                  class="blog-post-link"
                  href="<%= post.publicHref || buildInternalHref(post.relativeHref) %>"
                  data-post-slug="<%= post.slug %>"
                  hx-get="<%= post.fragmentHref %>"
                  hx-trigger="click"
                  hx-target="#blog-article"
                  hx-swap="innerHTML"
                  hx-push-url="true"
                  hx-indicator="#blog-loading"
                >
                  <h3><%= post.title %></h3>
                  <div class="blog-post-meta">
                    <% if (post.displayPublishedAt) { %>
                      <span><%= post.displayPublishedAt %></span>
                    <% } %>
                    <% if (post.readingMinutes) { %>
                      <span aria-hidden="true">•</span>
                      <span><%= post.readingMinutes %> min read</span>
                    <% } %>
                    <% if (post.author) { %>
                      <span aria-hidden="true">•</span>
                      <span><%= post.author.name %></span>
                    <% } %>
                  </div>
                  <% if (post.summary) { %>
                    <p><%= post.summary %></p>
                  <% } %>
                </a>
              </li>
            <% }); %>
          <% } %>
        </ul>
        <div class="blog-sidebar-pagination is-hidden" aria-label="Post pagination controls">
          <button type="button" class="sidebar-nav-btn" data-sidebar-prev>Prev</button>
          <button type="button" class="sidebar-nav-btn" data-sidebar-next>Next</button>
        </div>
      </aside>

      <div class="blog-article-shell">
        <div id="blog-article" aria-live="polite" aria-busy="false" hx-history-elt>
          <% if (page.initialPost) { %>
            <%- include('partials/article.ejs', { post: page.initialPost }) %>
          <% } else if (page.emptyStateHtml) { %>
            <div class="blog-empty-state"><%- page.emptyStateHtml %></div>
          <% } else { %>
            <p>Select a post to read.</p>
          <% } %>
        </div>
        <div id="blog-loading" class="htmx-indicator" role="status" aria-live="assertive">Loading…</div>
      </div>
    </section>
    <noscript>
      <p>HTMX powers instant loading here. With JavaScript disabled you can still read via the direct links above.</p>
    </noscript>
  </main>

  <footer>
    <% if (page.useCmFooter || site.useCmFooter) { %>
      <%- include('../partials/cm-footer.ejs') %>
    <% } %>
    <div class="container footer-container">
      <p class="footer-copy">&copy; <%= new Date().getFullYear() %> <%= site.title %></p>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var toggleBtn = document.querySelector('.nav-toggle');
      var headerEl = document.querySelector('header');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          headerEl.classList.toggle('nav-open');
        });
      }
    });

    function syncActiveLink(slug) {
      document.querySelectorAll('.blog-post-link').forEach(function(link) {
        if (slug && link.dataset.postSlug === slug) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    }

    var sidebar = document.querySelector('.blog-sidebar');
    var filterButtons = Array.from(document.querySelectorAll('.author-filter-btn'));
    var searchInput = document.querySelector('.post-search-input');
    var postItems = Array.from(document.querySelectorAll('[data-post-item]'));
    var pagination = document.querySelector('.blog-sidebar-pagination');
    var prevBtn = pagination ? pagination.querySelector('[data-sidebar-prev]') : null;
    var nextBtn = pagination ? pagination.querySelector('[data-sidebar-next]') : null;
    var pageSize = sidebar ? parseInt(sidebar.dataset.pageSize || '6', 10) || 6 : 6;
    var currentAuthor = 'all';
    var currentSearch = '';
    var currentPage = 0;

    function normaliseText(value) {
      return (value || '').toString().toLowerCase();
    }

    function itemMatchesFilters(item) {
      var isHidden = item.dataset.hidden === 'true';
      var title = item.dataset.title || normaliseText(item.querySelector('h3') && item.querySelector('h3').textContent);
      var summary = item.dataset.summary || normaliseText(item.querySelector('p') && item.querySelector('p').textContent);
      var searchMatch = !currentSearch || title.indexOf(currentSearch) !== -1 || summary.indexOf(currentSearch) !== -1;

      if (isHidden) {
        return currentSearch && searchMatch;
      }

      if (!searchMatch) {
        return false;
      }

      var authorMatch = currentAuthor === 'all' || item.dataset.author === currentAuthor;
      return authorMatch;
    }

    function updatePaginationControls(totalPages, visibleCount) {
      if (!pagination) return;
      if (visibleCount <= pageSize) {
        pagination.classList.add('is-hidden');
      } else {
        pagination.classList.remove('is-hidden');
      }
      if (prevBtn) {
        prevBtn.disabled = currentPage <= 0;
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage >= totalPages - 1;
      }
    }

    function applyFilters() {
      var filteredItems = [];
      postItems.forEach(function(item) {
        var matches = itemMatchesFilters(item);
        var isHidden = item.dataset.hidden === 'true';
        item.classList.toggle('is-hidden-filter', !matches);
        item.classList.toggle('is-search-visible', matches && isHidden);
        item.classList.remove('is-hidden-page');
        if (matches) {
          filteredItems.push(item);
        }
      });

      var totalPages = Math.max(1, Math.ceil(filteredItems.length / pageSize));
      if (currentPage >= totalPages) {
        currentPage = totalPages - 1;
      }
      var start = currentPage * pageSize;
      var end = start + pageSize;

      filteredItems.forEach(function(item, idx) {
        var inRange = idx >= start && idx < end;
        item.classList.toggle('is-hidden-page', !inRange);
      });

      updatePaginationControls(totalPages, filteredItems.length);
    }

    if (filterButtons.length) {
      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var authorId = btn.dataset.authorFilter;
          currentAuthor = authorId || 'all';
          currentPage = 0;
          filterButtons.forEach(function(b) {
            b.classList.toggle('is-active', b === btn);
          });
          applyFilters();
        });
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(event) {
        currentSearch = normaliseText(event.target.value).trim();
        currentPage = 0;
        applyFilters();
      });
    }

    if (pagination && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function() {
        if (currentPage > 0) {
          currentPage -= 1;
          applyFilters();
        }
      });
      nextBtn.addEventListener('click', function() {
        currentPage += 1;
        applyFilters();
      });
    }

    applyFilters();

    document.addEventListener('htmx:beforeRequest', function(event) {
      var trigger = event.detail && event.detail.elt;
      if (!trigger || !trigger.matches || !trigger.matches('.blog-post-link')) {
        return;
      }
      syncActiveLink(trigger.dataset.postSlug);
      var article = document.getElementById('blog-article');
      if (article) {
        article.setAttribute('aria-busy', 'true');
      }
    });

    document.addEventListener('htmx:afterSwap', function(event) {
      if (event.target && event.target.id === 'blog-article') {
        var articleNode = event.target.querySelector('[data-slug]');
        if (articleNode) {
          syncActiveLink(articleNode.getAttribute('data-slug'));
        }
        event.target.setAttribute('aria-busy', 'false');
      }
    });

    document.addEventListener('htmx:historyRestore', function() {
      var articleNode = document.querySelector('#blog-article [data-slug]');
      if (articleNode) {
        syncActiveLink(articleNode.getAttribute('data-slug'));
      } else {
        syncActiveLink(null);
      }
      var article = document.getElementById('blog-article');
      if (article) {
        article.setAttribute('aria-busy', 'false');
      }
    });
  </script>
</body>
</html>
