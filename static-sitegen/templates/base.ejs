<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= site.title %> – <%= page.title %></title>

  <% if (site.meta && site.meta.description) { %>
    <meta name="description" content="<%= site.meta.description %>">
  <% } %>
  <% if (site.meta && site.meta.keywords) { %>
    <meta name="keywords" content="<%= site.meta.keywords %>">
  <% } %>

  <!-- Include CM head content if specified -->
  <% if (page.useCmHead || site.useCmHead) { %>
    <%- include('partials/cm-head.ejs') %>
  <% } %>

  <!-- Stylesheets: use CM styles if CM is enabled, otherwise use provided styles -->
  <% if (page.useCmHead || site.useCmHead) { %>
    <!-- CM styles are already included in cm-head.ejs -->
  <% } else if (site.styles && site.styles.length > 0) { %>
    <% site.styles.forEach(function(style) { %>
      <link rel="stylesheet" href="<%= style %>">
    <% }); %>
  <% } else { %>
    <link rel="stylesheet" href="<%= isSection ? '../assets/modern.css' : 'assets/modern.css' %>">
  <% } %>
</head>

<body
  class="
    <%= (site.theme && site.theme.mode === 'dark') ? 'dark-mode' : 'light-mode' %>
    <%= site.parallaxImage ? ' with-parallax' : '' %>
    <%= (page.useCmConsole || site.useCmConsole || page.useCmHead || site.useCmHead || page.useCmFooter || site.useCmFooter) ? 'cm-body' : '' %>
  "
  data-theme="<%= (site.theme && site.theme.mode === 'dark') ? 'dark' : 'light' %>"
  <% if (site.parallaxPush) { %>
    style="--parallax-push:<%= site.parallaxPush %>;"
  <% } %>
>

  <!-- Optional Parallax Background DIV -->
  <% if (site.parallaxImage) { %>
    <div
      class="parallax-bg"
      style="background-image: url(
        '<%= isSection ? '../' + site.parallaxImage : site.parallaxImage %>'
      );"
    ></div>
  <% } %>

  <!-- HEADER -->
  <header>
    <div class="container header-container">
      <% if (site.logo) { %>
        <a href="<%= isSection ? '../index.html' : 'index.html' %>" class="logo-link">
          <img
            src="<%= isSection ? '../' + site.logo : site.logo %>"
            alt="<%= site.title %> Logo"
            class="logo"
          >
        </a>
      <% } else { %>
        <h1 class="logo-text"><%= site.title %></h1>
      <% } %>

      <% 
        // Compute navLinks for header; skip if absent or empty
        var navLinks = (site.header && site.header.links && site.header.links.length > 0)
          ? site.header.links.filter(function(link) { return !!link && !!link.label && !!link.href; })
          : [];
      %>

      <% if (navLinks.length > 0) { %>
        <!-- Hamburger toggle (only visible on ≤768px) -->
        <button type="button" class="nav-toggle" aria-label="Toggle navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7h18M3 12h18M3 17h18" />
          </svg>
        </button>
        <nav class="main-nav">
          <ul class="nav-links">
            <% navLinks.forEach(function(link) { 
                 let href = link.href;
                 if (link.href.startsWith('#')) {
                   href = isSection
                     ? '../sections/' + link.href.substring(1) + '.html'
                     : 'sections/' + link.href.substring(1) + '.html';
                 } else if (link.href === '/' || link.href === 'index.html') {
                   href = isSection ? '../index.html' : 'index.html';
                 } else if (!link.href.match(/^https?:\/\//)) {
                   href = isSection ? '../' + link.href : link.href;
                 }
            %>
              <li><a href="<%= href %>"><%= link.label %></a></li>
            <% }); %>
            <li><button type="button" class="theme-toggle" aria-label="Toggle contrast" title="Toggle contrast">◎</button></li>
          </ul>
        </nav>
      <% } %>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="container">
    <% if (!page.hideTitle) { %>
      <h2 class="page-title"><%= page.title %></h2>
    <% } %>

    <% if (page.image) { %>
      <div class="page-image<%= page.fullWidthImage ? ' full-viewport' : '' %>">
        <img src="<%= isSection ? '../' + page.image : page.image %>" alt="<%= page.title %> image">
      </div>
    <% } %>

    <!-- Include 3D Logo if specified -->
    <% if ((page.use3DLogo || site.use3DLogo) && !(page.useCmConsole || site.useCmConsole)) { %>
      <%- include('partials/cm-image.ejs') %>
    <% } else if ((page.cmImage || site.cmImage) && !(page.useCmConsole || site.useCmConsole)) { %>
      <%- include('partials/cm-image.ejs') %>
    <% } %>

    <!-- Include CM console if specified -->
    <% if (page.useCmConsole || site.useCmConsole) { %>
      <%- include('partials/cm-console.ejs') %>
    <% } %>

    <div class="page-content
      <%= page.contentFont === 'terminal' ? 'content-font-terminal' : 
         page.contentFont === 'modern-mono' ? 'content-font-modern-mono' : 
         page.contentFont === 'system-mono' ? 'content-font-system-mono' : '' %>
      <%= page.terminalStyle ? 'terminal-style' : '' %>">
      <%- content %>
    </div>

    <!-- Column Layout Support -->
    <% if (page.columnLayout && page.columnLayout.enabled) { %>
      <div class="two-column-layout <%= page.columnLayout.ratio.replace('/', '-') %>">
        <div class="left-column">
          <%- page.columnLayout.processedLeftContent || page.columnLayout.leftContent || '' %>
        </div>
        <div class="right-column">
          <%- page.columnLayout.processedRightContent || page.columnLayout.rightContent || '' %>
        </div>
      </div>
    <% } %>

    <% if (page.cta) { %>
      <div class="cta-wrapper">
        <a class="cta-btn" href="<%= page.cta.href %>">
          <%= page.cta.label %>
        </a>
      </div>
    <% } %>
  </main>

  <!-- FOOTER -->
  <footer>
    <!-- Include CM footer if specified -->
    <% if (page.useCmFooter || site.useCmFooter) { %>
      <%- include('partials/cm-footer.ejs') %>
    <% } %>
    
    <div class="container footer-container">
      <% if (site.footer && site.footer.links && site.footer.links.length > 0) { %>
        <nav>
          <ul class="footer-links">
            <% site.footer.links.forEach(function(link) { %>
              <li>
                <a href="<%= link.href %>" target="_blank" rel="noopener">
                  <%= link.label %>
                </a>
              </li>
            <% }); %>
          </ul>
        </nav>
      <% } %>
      <p class="footer-copy">
        &copy; <%= new Date().getFullYear() %> <%= site.title || 'Static Site' %>
      </p>
    </div>
  </footer>

  <!-- NAV TOGGLE SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var toggleBtn = document.querySelector('.nav-toggle');
      var headerEl = document.querySelector('header');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          headerEl.classList.toggle('nav-open');
        });
      }
    });
  </script>
</body>
</html>
